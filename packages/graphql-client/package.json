{
	"name": "@nxgt/graphql-client",
	"version": "0.0.0",
	"description": "A typed GraphQL client for the client preset's TypedDocumentNode, built on @nxgt/httpyz",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"graphql",
		"client",
		"typed-document-node",
		"httpyz",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-graphql.git",
		"directory": "packages/graphql-client"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "^3.2.0",
		"@nxgt/httpyz": "^0.3.3"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"graphql": "16.11.0"
	},
	"peerDependencies": {
		"graphql": "^16.11.0 || ^17.0.0",
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
